{
  "name": "agentic-meet",
  "version": "0.1.0",
  "description": "Create Daily and Whereby video meeting rooms with a Node.js SDK, CLI, and Model Context Protocol server.",
  "keywords": [
    "daily",
    "whereby",
    "video-meetings",
    "meeting-rooms",
    "join-links",
    "nodejs",
    "typescript",
    "cli",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "dry-run"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-meet.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-meet": "./dist/cli.js",
    "agentic-meet-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "^0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
